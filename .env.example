# Copy to .env and adjust. Every value is optional; defaults live in app/config.py.
# Never commit .env.

# Paths
# LMS_PROJECT_ROOT=
# LMS_COURSES_DIR=Courses
# LMS_RULES_FILE=config/ingestion_rules.json

# Chunking
# CHUNK_MAX_TOKENS=220
# CHUNK_OVERLAP_TOKENS=30
# LOW_TEXT_CHAR_THRESHOLD=40

# Embeddings and vector database
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_BATCH_SIZE=16
# CHROMA_DIR=vector_db/chroma
# CHROMA_COLLECTION=course_chunks

# Retrieval
# LMS_RETRIEVAL_RULES_FILE=config/retrieval_rules.json
# RETRIEVAL_TOP_K=4
# RETRIEVAL_MIN_SIMILARITY=0.30
# RETRIEVAL_MIN_SIMILARITY_NO_COURSE=0.445
# RETRIEVAL_MIN_SIMILARITY_FOLLOW_UP=0.40
# RETRIEVAL_FOLLOW_UP_MIN_EXAMPLE=0.50
# RETRIEVAL_FOLLOW_UP_MAX_WORDS=5
# RETRIEVAL_MIN_INTENT_SIMILARITY=0.55
# RETRIEVAL_MIN_INTENT_MARGIN=0.03

# Answer generation: ollama runs a model on this machine, gemini uses Google's service.
# LLM_PROVIDER=gemini

# Local model. Install it first: ollama pull qwen3:1.7b
# LLM_MODEL=qwen3:1.7b
# LLM_BASE_URL=http://localhost:11434
# NUM_CTX=4096
# LLM_NUM_PREDICT=512
# LLM_KEEP_ALIVE=30m
# OLLAMA_TIMEOUT_SECONDS=180

# Gemini. The free tier is for the demo PDFs only, never real PDFs or student data.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low
# LLM_TEMPERATURE=0.2
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_TIMEOUT_SECONDS=30
# MAX_QUESTION_CHARS=500

# REST API. There is no API key yet, so keep API_HOST on this machine.
# API_HOST=127.0.0.1
# API_PORT=8000
# CHAT_MAX_SESSIONS=200
# CHAT_SESSION_TTL_MINUTES=60
# CHAT_STARTUP_WAIT_SECONDS=60
# HEALTH_TIMEOUT_SECONDS=3
